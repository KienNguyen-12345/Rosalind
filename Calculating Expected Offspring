# Calculating Expected Offspring (Rosalind IEV)
# Author: Kien Nguyen
# Calculates the expected number of offspring with the dominant phenotype
# given counts of couples for each of 6 genotype pairings.

data <- readLines("rosalind_iev.txt")
data <- strsplit(data, " ")[[1]]

couple_1 <- data[1]
couple_2 <- data[2]
couple_3 <- data[3]
couple_4 <- data[4]
couple_5 <- data[5]
couple_6 <- data[6]
number_of_couple <- c(couple_1, couple_2, couple_3, couple_4, couple_5, couple_6)


prob_of_dom <- c(2,2,2,1.5,1,0)
'Why 2,2,2,1.5,1,0?
      Chance of having dominant phenotype (having at least 1 "A" allele)
AA-AA: 100% - 1
AA-Aa: 100% - 1
AA-aa: 100% - 1
Aa-Aa: 75% - 0.75
Aa-aa: 50% - 0.5
aa-aa: 0% - 0
So the chances of 1 offspring with dominant phenotype are: 1,1,1,0.75,0.5,0
 ==> Multiply by 2 for 2 offsprings: 2,2,2,1.5,1,0'

number_of_offpsring_with_dom <- sum(number_of_couple*prob_of_dom)
print(number_of_offpsring_with_dom)
